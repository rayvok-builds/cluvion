node_modules
# ==========================================
# 1. DEPENDENCIES & PACKAGE MANAGERS
# ==========================================
# Keeps your repository small; dependencies are re-downloaded via 'npm install'
node_modules/
.pnp
.pnp.js

# ==========================================
# 2. NEXT.JS BUILD & PRODUCTION OUTPUTS
# ==========================================
# These are generated dynamically every time you run 'npm run build'
.next/
out/

# ==========================================
# 3. ENVIRONMENT VARIABLES & SECRETS (CRITICAL)
# ==========================================
# Never commit your actual keys to GitHub. 
# Only '.env.example' should be public.
.env*.local
.env.development.local
.env.production.local
.env.test.local

# ==========================================
# 4. LOGS & DIAGNOSTICS
# ==========================================
# Error logs generated when a crash or failure happens
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# 5. TESTING & COVERAGE
# ==========================================
# Reports created by tools like Jest or Cypress
coverage/
.nyc_output

# ==========================================
# 6. IDEs, EDITORS, & SYSTEM FILES
# ==========================================
# Settings specific to your computer's OS or code editor
.DS_Store
*.pem
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
